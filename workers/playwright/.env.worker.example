# Worker environment — copy to .env.worker (same directory), fill in,
# and chmod 600. NEVER commit the filled file. On managed hosts, inject
# these from the platform's secret store instead of a file.
#
# Required — the worker's database identity. SECRET: the service-role
# key bypasses RLS; it exists only in this worker's environment, is
# never sent to a browser, and is never logged.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning (defaults shown in docs/WORKER_DEPLOYMENT.md).
WORKER_ID=
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_LEASE_MS=300000
# WORKER_JOB_TIMEOUT_MS=120000
# WORKER_MAX_CONCURRENT_PER_WORKSPACE=2
# WORKER_DAILY_JOB_LIMIT=50
# WORKER_MAX_PARALLEL_JOBS=1
# WORKER_HEALTH_PORT=8080
# WORKER_SHUTDOWN_TIMEOUT_MS=30000
# WORKER_MAX_SCREENSHOT_BYTES=1000000
# WORKER_MAX_SCREENSHOTS_PER_JOB=2
