# TestPilot AI — environment variables (names only, no values).
# Copy to .env.local for local development. Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=

# --- AI provider (server-side only) ---
# Provider: openai | anthropic. Credentials never leave the server.
AI_PROVIDER=openai
# Optional: override the default low-cost model (gpt-4o-mini / claude-3-5-haiku-20241022).
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Guards: timeout per request (ms), SDK retries (0-5), max input chars per field.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=12000
# Per-workspace daily quotas.
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=200000

# --- Playwright worker (future) ---
PLAYWRIGHT_WORKER_URL=
PLAYWRIGHT_WORKER_TOKEN=

# --- GitHub Actions integration ---
# AES-256-GCM key for integration secrets at rest (base64, 32 bytes).
# Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# --- Usage metering / free plan (docs/COST_MODEL.md) ---
# Monthly free-plan limits per workspace. Defaults shown; uncomment to change.
# USAGE_FREE_AI_CALLS=200
# USAGE_FREE_BROWSER_RUNS=100
# USAGE_FREE_EXECUTION_SECONDS=3600
# USAGE_FREE_STORAGE_BYTES=524288000
# Demo mode: AI features return locally generated sample output — no API
# key needed and no paid calls are made. Set to "true" to enable.
AI_DEMO_MODE=
