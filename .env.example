# TestPilot AI — environment variables (names only, NO real values).
#
# The same variable names are used in all three environments; only the
# VALUES and where they live differ (see docs/DEPLOYMENT.md for the
# full matrix):
#
#   Local       → this file copied to .env.local (gitignored). Points at
#                 the local Supabase stack (supabase start).
#   Preview     → Vercel project → Settings → Environment Variables,
#                 target "Preview". Points at the CLOUD Supabase project.
#   Production  → Vercel project → Settings → Environment Variables,
#                 target "Production". Points at the CLOUD Supabase project.
#
# Rules: secrets (anything marked SECRET) are entered ONLY in the
# Vercel/Supabase dashboards — never in git, never in chat. Preview and
# production use separate values where a provider supports it (separate
# AI keys, separate INTEGRATION_ENCRYPTION_KEY) so a preview leak can
# never touch production.

# --- Supabase (from the Supabase project's API settings) ---
# Publishable/anon key — safe to expose to the browser, RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server-only; bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public origin of THIS deployment (local: http://localhost:3000;
# preview: the preview domain; production: the production domain).
# Used for auth redirects and integration report/status links.
NEXT_PUBLIC_APP_URL=

# --- AI provider (server-side only; credentials never leave the server) ---
# Provider: openai | anthropic.
AI_PROVIDER=openai
# Optional: override the default low-cost model (gpt-4o-mini / claude-3-5-haiku-20241022).
AI_MODEL=
# SECRET (one per provider you use; use SEPARATE keys for preview/production).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Guards: timeout per request (ms), SDK retries (0-5), max input chars per field.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=12000
# Per-workspace daily quotas.
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=200000
# Demo mode: AI features return locally generated sample output — no API
# key needed and no paid calls are made. Set to "true" to enable.
# (Reasonable for preview demos; keep unset/false in production.)
AI_DEMO_MODE=

# --- Playwright worker (deployed separately — NOT on Vercel) ---
PLAYWRIGHT_WORKER_URL=
# SECRET. Shared token between the app and the worker.
PLAYWRIGHT_WORKER_TOKEN=

# --- GitHub Actions integration ---
# SECRET. AES-256-GCM key for integration secrets at rest (base64, 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT key per environment; rotating it makes stored
# integration secrets unreadable (integrations must be reconnected).
INTEGRATION_ENCRYPTION_KEY=

# --- Usage metering / free plan (docs/COST_MODEL.md) ---
# Monthly free-plan limits per workspace. Defaults shown; uncomment to change.
# USAGE_FREE_AI_CALLS=200
# USAGE_FREE_BROWSER_RUNS=100
# USAGE_FREE_EXECUTION_SECONDS=3600
# USAGE_FREE_STORAGE_BYTES=524288000

# --- Vercel-provided (reference only — set automatically by Vercel) ---
# VERCEL=1, VERCEL_ENV (production|preview|development), VERCEL_URL,
# VERCEL_GIT_COMMIT_SHA. The health endpoint reports VERCEL_ENV.
