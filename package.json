  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "MIT",
  "name": "testpilot-ai",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "worker:build": "tsc -p workers/playwright/tsconfig.json && node -e \"require('fs').writeFileSync('workers/playwright/dist/package.json', JSON.stringify({ type: 'module' }))\"",
    "worker:start": "npm run worker:build && node workers/playwright/dist/workers/playwright/src/index.js"
  },
  "version": "0.1.0"
