{
  "allowedHosts": ["127.0.0.1"],
  "baseUrl": "http://127.0.0.1:4321",
  "name": "Demo app — sign-in flow",
  "steps": [
    { "action": "goto", "url": "/" },
    {
      "action": "assertText",
      "locator": { "by": "role", "name": "Acme Demo Store", "role": "heading" },
      "text": "Acme Demo Store"
    },
    { "action": "click", "locator": { "by": "role", "name": "Sign in", "role": "link" } },
    { "action": "assertUrl", "expected": "/login", "match": "contains" },
    {
      "action": "fill",
      "locator": { "by": "label", "label": "Email" },
      "value": "demo@example.com"
    },
    {
      "action": "fill",
      "locator": { "by": "label", "label": "Password" },
      "value": "demo-password"
    },
    { "action": "click", "locator": { "by": "role", "name": "Sign in", "role": "button" } },
    { "action": "assertUrl", "expected": "/dashboard", "match": "contains" },
    {
      "action": "assertText",
      "locator": { "by": "role", "name": "Dashboard", "role": "heading" },
      "text": "Dashboard"
    },
    {
      "action": "assertText",
      "locator": { "by": "text", "text": "Welcome back, Demo User." },
      "text": "Welcome back"
    }
  ],
  "version": "1"
}
